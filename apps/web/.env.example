# ---------------------------------------------------------------------------
# Prema — web app environment
#
# Nothing here is required to run the free report. Every value is absent-safe:
# the event sink falls back to a structured log, and payments stay switched off.
# ---------------------------------------------------------------------------

# --- Instrumentation --------------------------------------------------------
# Server-side only. Never expose the secret key to the browser — the event sink
# is deliberately NOT an anonymous-insert RLS policy, because a public write
# endpoint holding the primary success metric is trivially forgeable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Payments ---------------------------------------------------------------
# The kill switch. Leave false until KYC has cleared AND the legal pages are
# live on a registered custom domain (a *.vercel.app address will not pass).
PAYMENTS_LIVE=false

# Price in MINOR units, e.g. 49900 = INR 499.
#
# UNRESOLVED: nobody has named the price. An unnamed price makes the
# willingness-to-pay experiment uninterpretable, so decide it before switching
# PAYMENTS_LIVE on. Anchor against what a family pandit charges per
# consultation, since that is the substitute good.
REVIEW_PRICE_MINOR=
REVIEW_CURRENCY=INR

# Hosted checkout link. No card data ever touches this app.
CHECKOUT_URL=

# Shared secret for verifying webhook signatures. Without it the webhook route
# refuses every request with a 503 rather than trusting unsigned input.
PAYMENT_WEBHOOK_SECRET=
